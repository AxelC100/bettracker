PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=bettracker
# Alternatively set DATABASE_URL instead of DB_*.
# Production: HTTPS and a reverse proxy serving /api on the same origin.
NODE_ENV=development
# Optional external connections (server only; never VITE_*):
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4.1-mini
# API_SPORTS_KEY=
# Optional separate keys per sport override the shared key:
# API_SPORTS_FOOTBALL_KEY=
# API_SPORTS_BASKETBALL_KEY=
# API_SPORTS_BASEBALL_KEY=
# RESULTS_INTERVAL_MINUTES=15
# RESULTS_TIMEZONE=America/Costa_Rica
